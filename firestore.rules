rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    function isOwner() {
      return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid;
    }

    // The organiser is whoever claims this document first. Nobody can change it afterwards.
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
    }

    // Beer prices, team names, shared costs, paid flags: organiser only.
    match /config/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /paid/{id}   { allow read: if signedIn(); allow write: if isOwner(); }

    // Players: the organiser manages everyone, each person manages only their own profile.
    match /players/{id} {
      allow read: if signedIn();
      allow create, update: if isOwner()
        || (id == 'u-' + request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if isOwner();
    }

    // Beer entries: anyone signed in can add one, you can remove your own, the organiser can remove any.
    match /drinks/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner() || (signedIn() && resource.data.by == request.auth.uid);
    }
  }
}
